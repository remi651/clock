# Public HTTPS origin registered in Google Cloud. Never use a wildcard redirect.
APP_URL=http://localhost:3000
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SQLite remains on this machine; use a persistent volume in production.
DATABASE_PATH=./data/clock.sqlite
# Dedicated API account from Furious administration. Server-side only.
FURIOUS_API_USERNAME=
FURIOUS_API_PASSWORD=
# Optional fallback, only when the user's daily-hours history is empty.
# Set the real hours per day used in Furious; no default is assumed.
FURIOUS_HOURS_PER_DAY=
