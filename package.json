{
  "name": "katra-clock",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "demo": "node --env-file-if-exists=.env server.js --demo",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "build:mac": "node scripts/build-mac.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "express": "5.1.0",
    "gaxios": "8.3.2",
    "google-auth-library": "11.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
